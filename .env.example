# ─────────────────────────────────────────────────────────────────────────────
# Seal Team BD — environment configuration
#
# Copy this file to `.env.local` and fill in real values for local development,
# or set these as environment variables in Vercel for staging/production.
#
# NEVER commit real secrets. Anything prefixed NEXT_PUBLIC_ is inlined into the
# browser bundle and is NOT a secret. Everything else is server-only.
#
# Validated at runtime by lib/env.ts (zod). In production a missing/invalid
# REQUIRED var fails fast; in dev/build, placeholders only log a warning so the
# app still boots. The two NEXT_PUBLIC_SUPABASE_* vars are the only required ones.
#
# INTEGRATION TIERS — the app runs WITHOUT the paid keys:
#   [CORE]  Supabase (required) + OpenAI (AI features; cheap, bring your own key).
#   [FREE]  SEC EDGAR + USASpending + building permits — no key, always on. These
#           drive the signal/scoring loop on their own.
#   [PAID]  Apollo + ZoomInfo + SerpAPI — C&W-funded, slot in later. Unset = those
#           routes return 503 {configured:false} (clean "connect X"), never a 500.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project URL — found in Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon (publishable) key — safe for the browser; RLS is the actual guard.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase service role (server-only secret) ───────────────────────────────
# Bypasses RLS for trusted server routes (bulk imports). NEVER NEXT_PUBLIC_,
# never sent to the browser. Read only by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (server-only) ─────────────────────────────────────────────────────
# Powers the verified-signals-only audit narrative and the generation routes.
OPENAI_API_KEY=your-openai-api-key

# ── Enrichment / sourcing providers [PAID — C&W-funded, deferred] ────────────
# Unset on the free tier: enrich/leads/decision-makers degrade cleanly (503 or
# unscored results), they don't error. Drop these in when C&W funds them.
# Apollo — contact enrichment + decision-maker lookup.
APOLLO_API_KEY=your-apollo-key
# SerpAPI — Google-backed company/news discovery.
SERP_API_KEY=your-serpapi-key
# ZoomInfo — firmographic enrichment (OAuth client-credentials pair).
ZOOMINFO_CLIENT_ID=your-zoominfo-client-id
ZOOMINFO_PRIVATE_KEY=your-zoominfo-private-key

# ── Self-registration allowlist (optional) ───────────────────────────────────
# Comma-separated email domains permitted to self-register. Empty/unset = no
# allowlist. Set to C&W's domain in prod, or disable open sign-ups entirely in
# Supabase Auth settings (the stronger control). New accounts are unapproved.
ALLOWED_SIGNUP_DOMAINS=cushwake.com

# ── SEC EDGAR (optional) ─────────────────────────────────────────────────────
# SEC requires a descriptive User-Agent with real contact info or it returns 403.
SEC_EDGAR_UA=Cushman & Wakefield Seal Team BD you@cushwake.com

# ── Explorium / Vibe Prospecting (Phase 2 signal source, optional) ───────────
# OFF unless EXPLORIUM_ENABLED=true AND a key is set — it's metered by credits,
# so it stays disabled until the data is validated and the subscription is agreed.
EXPLORIUM_ENABLED=false
EXPLORIUM_API_KEY=your-explorium-api-key
# EXPLORIUM_API_BASE=https://api.explorium.ai

# ── Building permits (Socrata open data, free, optional) ─────────────────────
# JSON array of dataset specs; empty/unset = source off. Optional app token only
# raises rate limits. Example below is San Diego County's permits dataset — CONFIRM
# the column names (nameField/dateField/descField/addressField) against the dataset
# schema at https://data.sandiegocounty.gov/resource/dyzh-7eat.json before enabling.
# PERMITS_DATASETS=[{"domain":"data.sandiegocounty.gov","datasetId":"dyzh-7eat","nameField":"applicant","dateField":"issue_date","descField":"permit_type","addressField":"address"}]
# SOCRATA_APP_TOKEN=your-socrata-app-token
